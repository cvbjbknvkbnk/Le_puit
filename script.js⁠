// Variable globale 3D
let scene, camera, renderer, cube;
let isPlaying = false;
let currentMultiplier = 1.00;
let currentRempart = 0;
let interval;
let solde = 413711;

// Initialisation Three.js
function init3D() {
  const container = document.getElementById('canvas-container');
  if (!container) return;

  scene = new THREE.Scene();
  scene.background = new THREE.Color(0x1a1a2e);

  camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
  camera.position.z = 5;

  renderer = new THREE.WebGLRenderer({ antialias: true });
  renderer.setSize(window.innerWidth, window.innerHeight);
  container.innerHTML = '';
  container.appendChild(renderer.domElement);

  // Objet 3D (Cube animé)
  const geometry = new THREE.BoxGeometry(1.5, 1.5, 1.5);
  const material = new THREE.MeshBasicMaterial({ color: 0x00fff0, wireframe: true });
  cube = new THREE.Mesh(geometry, material);
  scene.add(cube);

  // Redimensionnement
  window.addEventListener('resize', () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
  });

  animate();
}

function animate() {
  requestAnimationFrame(animate);
  if (cube) {
    cube.rotation.x += 0.01;
    cube.rotation.y += 0.01;
  }
  if (renderer && scene && camera) {
    renderer.render(scene, camera);
  }
}

// Événements du jeu
document.addEventListener('DOMContentLoaded', () => {
  init3D();

  const btnPlay = document.getElementById('btn-play');
  const btnCashout = document.getElementById('btn-cashout');
  const btnReplay = document.getElementById('btn-replay');
  const modal = document.getElementById('game-over-modal');

  if (btnPlay) {
    btnPlay.addEventListener('click', () => {
      isPlaying = true;
      btnPlay.disabled = true;
      btnCashout.disabled = false;
      modal.classList.add('hidden');
      
      interval = setInterval(() => {
        currentMultiplier += 0.05;
        currentRempart += 1;
        document.getElementById('multiplier').innerText = currentMultiplier.toFixed(2) + 'x';
        document.getElementById('rempart').innerText = currentRempart;

        // Crash aléatoire
        if (Math.random() < 0.05) {
          clearInterval(interval);
          isPlaying = false;
          btnPlay.disabled = false;
          btnCashout.disabled = true;
          modal.classList.remove('hidden');
        }
      }, 200);
    });
  }

  if (btnCashout) {
    btnCashout.addEventListener('click', () => {
      if (!isPlaying) return;
      clearInterval(interval);
      isPlaying = false;
      solde += Math.floor(1000 * currentMultiplier);
      document.getElementById('solde').innerText = solde;
      btnPlay.disabled = false;
      btnCashout.disabled = true;
    });
  }

  if (btnReplay) {
    btnReplay.addEventListener('click', () => {
      currentMultiplier = 1.00;
      currentRempart = 0;
      document.getElementById('multiplier').innerText = '1.00x';
      document.getElementById('rempart').innerText = '0';
      modal.classList.add('hidden');
    });
  }
});
