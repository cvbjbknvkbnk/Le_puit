* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  user-select: none;
}

body, html {
  width: 100%;
  height: 100%;
  overflow: hidden;
  background-color: #1a1a2e;
  color: #ffffff;
}

#canvas-container {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

#ui-container {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 2;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 20px;
  pointer-events: none;
}

.hud, .controls {
  pointer-events: auto;
}

.hud {
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(10px);
  padding: 15px;
  border-radius: 12px;
  text-align: center;
}

#multiplier {
  font-size: 2.5rem;
  font-weight: bold;
  color: #00fff0;
  margin: 10px 0;
}

.controls {
  display: flex;
  gap: 10px;
  margin-bottom: 20px;
}

input, button {
  padding: 12px;
  border: none;
  border-radius: 8px;
  font-size: 1rem;
  font-weight: bold;
}

input {
  flex: 1;
  background: rgba(255, 255, 255, 0.9);
  color: #000;
  text-align: center;
}

button {
  flex: 1;
  cursor: pointer;
  transition: transform 0.1s;
}

#btn-play { background: #00e676; color: #000; }
#btn-cashout { background: #ffea00; color: #000; }
button:disabled { opacity: 0.5; }

.hidden { display: none !important; }

#game-over-modal {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(255, 0, 85, 0.9);
  padding: 30px;
  border-radius: 16px;
  text-align: center;
  pointer-events: auto;
}

#btn-replay {
  margin-top: 15px;
  background: #ffffff;
  color: #000;
}
